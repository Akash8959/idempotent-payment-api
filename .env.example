# Server Configuration
PORT=8080
ENV=development
LOG_LEVEL=INFO
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# Database Configuration (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=payment_db
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# Idempotency Rules
IDEMPOTENCY_KEY_TTL=24h
IDEMPOTENCY_RECOVERY_TIMEOUT=30s

# Processor Simulation (modes: success, failure, timeout)
PROCESSOR_DEFAULT_MODE=success
PROCESSOR_TIMEOUT=5s
